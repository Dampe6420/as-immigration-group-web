---
import Icon from '../Icon.astro';
import type { Dict } from '../../i18n/es';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section class="section" id="preguntas">
  <div class="container faq">
    <div class="section-head section-head--center">
      <span class="kicker">{t.faq.kicker}</span>
      <h2>{t.faq.title}</h2>
    </div>
    <div class="faq__list">
      {
        t.faq.items.map((f) => (
          <details class="faq__item">
            <summary>
              <span>{f.q}</span>
              <Icon name="plus" class="icon faq__icon" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__list {
    max-width: 820px;
    margin-inline: auto;
    display: grid;
    gap: 12px;
  }
  .faq__item {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .faq__item[open] {
    border-color: var(--lilac-300);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    color: var(--plum-800);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__item p {
    margin: 0;
    padding: 0 22px 20px;
    color: var(--ink-soft);
  }
  :global(.faq__icon) {
    color: var(--violet-600);
    transition: transform 0.2s;
  }
  .faq__item[open] :global(.faq__icon) {
    transform: rotate(45deg);
  }
</style>
