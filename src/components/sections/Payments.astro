---
import type { Dict } from '../../i18n/es';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section class="section section--white" id="pagos">
  <div class="container">
    <div class="section-head">
      <span class="kicker">{t.payments.kicker}</span>
      <h2>{t.payments.title}</h2>
      <p class="pay-quote">{t.paymentNotice}</p>
    </div>

    <h3>{t.payments.breakdownTitle}</h3>
    <div class="grid grid--3">
      {
        t.payments.breakdown.map((b, i) => (
          <div class:list={['card', 'cost', i === 0 && 'cost--ours']}>
            <h4>{b.title}</h4>
            <p>{b.text}</p>
          </div>
        ))
      }
    </div>

    <p class="pay-pending">{t.payments.pending}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href="#contacto">{t.cta.payments}</a>
    </div>
  </div>
</section>

<style>
  .pay-quote {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.4;
    color: var(--plum-700);
    border-left: 4px solid var(--violet-600);
    padding-left: 18px;
    margin: 0;
  }
  .cost h4 {
    margin: 0 0 0.5em;
    color: var(--plum-800);
    font-size: 1.08rem;
  }
  .cost p {
    margin: 0;
    color: var(--ink-soft);
  }
  .cost--ours {
    background: var(--lilac-100);
    border-color: var(--lilac-300);
  }
  .pay-pending {
    margin: 24px 0 20px;
    font-weight: 600;
    color: var(--ink-soft);
  }
</style>
