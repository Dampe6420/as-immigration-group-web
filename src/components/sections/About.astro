---
import type { Dict } from '../../i18n/es';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
// TODO (DUDAS.md): agregar historia, foto y datos de la fundadora cuando el cliente los entregue.
---

<section class="section section--white" id="quienes-somos">
  <div class="container about">
    <div>
      <span class="kicker">{t.about.kicker}</span>
      <h2>{t.about.title}</h2>
      {t.about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="about__values">
      {
        t.about.values.map((v, i) => (
          <div class="about__value">
            <span class="about__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
  }
  .about__values {
    display: grid;
    gap: 14px;
    align-content: center;
  }
  .about__value {
    display: flex;
    gap: 18px;
    padding: 20px 22px;
    border-radius: var(--radius);
    background: var(--lilac-50);
    border: 1px solid var(--line);
  }
  .about__value h3 {
    margin-bottom: 0.2em;
  }
  .about__value p {
    margin: 0;
    color: var(--ink-soft);
  }
  .about__num {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--lilac-300);
    line-height: 1;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 1.1fr 1fr;
    }
  }
</style>
