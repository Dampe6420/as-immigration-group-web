---
import Icon from '../Icon.astro';
import type { Dict } from '../../i18n/es';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section class="section section--tint" id="expediente">
  <div class="container delivery">
    <div>
      <span class="kicker">{t.delivery.kicker}</span>
      <h2>{t.delivery.title}</h2>
      <p class="lead">{t.delivery.intro}</p>
      <ul class="delivery__list">
        {
          t.delivery.items.map((item) => (
            <li>
              <Icon name="folder" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="delivery__diff">
      <h3>{t.delivery.diffTitle}</h3>
      {
        t.delivery.diff.map((d, i) => (
          <div class:list={['diff', i === 1 && 'diff--official']}>
            <h4>{d.title}</h4>
            <p>{d.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .delivery {
    display: grid;
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
  }
  .delivery__list {
    list-style: none;
    margin: 1.4em 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .delivery__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--white);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    border: 1px solid var(--line);
  }
  .delivery__list :global(.icon) {
    margin-top: 3px;
    color: var(--violet-600);
  }
  .delivery__diff {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.5vw, 34px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .diff {
    border-left: 4px solid var(--lilac-300);
    padding: 4px 0 4px 16px;
    margin-top: 18px;
  }
  .diff--official {
    border-left-color: var(--violet-600);
  }
  .diff h4 {
    margin: 0 0 0.3em;
    color: var(--plum-800);
    font-size: 1.05rem;
  }
  .diff p {
    margin: 0;
    color: var(--ink-soft);
  }
  @media (min-width: 900px) {
    .delivery {
      grid-template-columns: 1.2fr 1fr;
    }
    .delivery__diff {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
</style>
