---
/** Página de inicio completa; se reutiliza para cada idioma. */
import Base from '../layouts/Base.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Services from './sections/Services.astro';
import Process from './sections/Process.astro';
import Delivery from './sections/Delivery.astro';
import Payments from './sections/Payments.astro';
import Faq from './sections/Faq.astro';
import Contact from './sections/Contact.astro';
import { getDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
---

<Base locale={locale}>
  <Hero t={t} />
  <About t={t} />
  <Services t={t} />
  <Process t={t} />
  <Delivery t={t} />
  <Payments t={t} />
  <Faq t={t} />
  <Contact t={t} locale={locale} />
</Base>
